# URL da FastAPI (efemérides e registros de observação), sem barra no final.
# Local: http://localhost:8000. Produção: URL do projeto observatorio-otto-api na Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL do CMS Payload (conteúdo editorial e login), sem barra no final.
# Local: http://localhost:3000 (backend/cms). Produção: URL do projeto observatorio-otto-cms.
NEXT_PUBLIC_CMS_URL=http://localhost:3000

# Coordenadas Padrão (Observatório Otto de Alencar - Fortaleza/CE)
NEXT_PUBLIC_OBSERVATORIO_LAT=-3.7793
NEXT_PUBLIC_OBSERVATORIO_LON=-38.5661
