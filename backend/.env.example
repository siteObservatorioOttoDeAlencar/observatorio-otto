# Variáveis lidas pelo docker-compose.yml (desenvolvimento local).
# Copie para .env — todas têm valor padrão, então o arquivo é opcional.
# Os projetos cms/ e api_python/ têm os próprios .env.example.

POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio
POSTGRES_DB=observatorio

# Porta do Postgres no seu computador. Troque (ex.: 5433) se já houver um
# Postgres instalado na máquina usando a 5432.
POSTGRES_PORT=5432

# Usadas pelo contêiner da FastAPI.
# O cms/ roda no seu computador (npm run dev), por isso o padrão aponta para o host.
CMS_URL=http://host.docker.internal:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
