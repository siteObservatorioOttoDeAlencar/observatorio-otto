# Conexão do Postgres.
# Local: o Postgres do docker-compose da raiz do repositório.
# Vercel: injetada pela integração Neon (use a URL "pooled").
DATABASE_URL=postgres://observatorio:observatorio@127.0.0.1:5432/observatorio

# Segredo do Payload (JWT/cookies). Gere com: openssl rand -hex 32
PAYLOAD_SECRET=

# Token do Vercel Blob (store de leitura/escrita).
# Em branco no desenvolvimento local: os arquivos ficam em cms/media.
# Na Vercel é injetado ao conectar o Blob store ao projeto.
BLOB_READ_WRITE_TOKEN=

# CORS: URL(s) do frontend autorizadas a chamar o CMS pelo navegador (separadas por vírgula, sem barra final).
# Local: o site roda em http://localhost:3001 (ou 3000).
ALLOWED_ORIGINS=http://localhost:3001
