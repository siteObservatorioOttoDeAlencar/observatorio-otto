# URL pública do CMS (Payload), sem barra no final.
# Local: o cms/ roda no host (npm run dev). Fora do Docker use http://localhost:3000;
# dentro do docker-compose o padrão já é http://host.docker.internal:3000.
CMS_URL=http://localhost:3000

# Postgres (mesmo banco do CMS; a FastAPI usa o schema "observacoes").
# Local: Postgres do docker-compose. Vercel: URL do Neon (a mesma do CMS).
DATABASE_URL=postgresql://observatorio:observatorio@localhost:5432/observatorio

# Origens do frontend autorizadas no CORS, separadas por vírgula (sem barra final).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Opcionais: coordenadas do observatório (padrão: Fortaleza).
# OBSERVATORIO_LAT=-3.7793
# OBSERVATORIO_LON=-38.5661
